# Copy this file to .env for local Docker runs.
# Use non-default values. Do not commit .env.

POSTGRES_PASSWORD=change_me_postgres_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_PASSWORD=change_me_mysql_app_password
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# Optional explicit Dynamic D1 cohort-HMAC key (minimum 32 bytes). When empty
# locally, the private Redis volume provisions and retains a random key. AWS
# deployment must supply this from a secrets manager and keep it stable for an
# entire experiment epoch.
EXPERIMENT_ASSIGNMENT_SECRET=

# Optional Phase 18 local CPU inference. Start only with: --profile local-ai
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://local-llm:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_MAX_PROMPT_CHARS=4096
LOCAL_LLM_MAX_OUTPUT_TOKENS=128
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_MAX_QUEUE_DEPTH=2

# Base64 of at least 32 random bytes; generate locally, never commit a real value.
# Missing/invalid disables fake_ account creation and authentication (seeded auth remains).
# Keep stable across restarts; rotation requires an explicit registry migration.
DECEPTIVE_PRINCIPAL_HMAC_SECRET=
