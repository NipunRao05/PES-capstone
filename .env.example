# Copy this file to .env only if it does not already exist.
# Start via: python scripts/honeypot.py compose up -d --build --remove-orphans
# Features/policy live in config/*.yaml. Nonempty COMPOSE_PROFILES is rejected.
# Use non-default values. Do not commit .env.
# Local .env compatibility is separate from strict VM deployment mode.
# For deployment use deployment/secrets.env.example, owner-only mode 600, and
# HONEYPOT_DEPLOYMENT_MODE=true / HONEYPOT_SECRET_FILE outside the release tree.
# Operator credentials must be independent/random; decoy logins may be intentional.
# Never regenerate principal HMAC or EVIDENCE_IP_HASH_SALT on reboot.

POSTGRES_PASSWORD=change_me_postgres_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_PASSWORD=change_me_mysql_app_password
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# Optional separate public decoy-login passwords. Omit to retain existing local
# login passwords; public deployments should explicitly separate these from admin.
# PG_DECOY_PASSWORD=change_me_public_decoy_password
# MYSQL_DECOY_PASSWORD=change_me_public_decoy_password
# MYSQL_DECOY_ROOT_PASSWORD=change_me_public_decoy_password
# Runtime passwords are normally derived from the stable principal HMAC key.
# Optional explicit PG_RUNTIME_PASSWORD / MYSQL_RUNTIME_PASSWORD must remain private.

# Optional explicit Dynamic D1 cohort-HMAC key (minimum 32 bytes). When empty
# locally, the private Redis volume provisions and retains a random key. AWS
# deployment must supply this from a secrets manager and keep it stable for an
# entire experiment epoch.
EXPERIMENT_ASSIGNMENT_SECRET=

# Future Phase 18 local CPU inference settings retained for later review.
# This deterministic launcher rejects activation of future features.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://local-llm:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_MAX_PROMPT_CHARS=4096
LOCAL_LLM_MAX_OUTPUT_TOKENS=128
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_MAX_QUEUE_DEPTH=2

# Base64 of at least 32 random bytes; generate locally, never commit a real value.
# Canonical preflight rejects missing/invalid keys while deceptive_principals is enabled.
# Keep stable across restarts; rotation requires an explicit registry migration.
DECEPTIVE_PRINCIPAL_HMAC_SECRET=

# Legacy compatibility values must agree with config/features.yaml.
MITRE_ENABLED=false
COMPOSE_PROFILES=

# Optional deployment-specific public proxy ports (loopback only).
PGPROXY_HOST_PORT=5432
MYSQLPROXY_HOST_PORT=3306
