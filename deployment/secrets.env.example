# Owner/root-only mode 600, outside source/release archives. NO REAL VALUES HERE.
# Deployment mode requires explicit independent random operator secrets >=32 chars.
POSTGRES_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
MYSQL_ROOT_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
MYSQL_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
GRAFANA_ADMIN_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
PG_RUNTIME_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
MYSQL_RUNTIME_PASSWORD=GENERATE_INDEPENDENT_RANDOM_OPERATOR_SECRET
# Explicit decoy credentials may intentionally be weak; never reuse operator keys.
PG_DECOY_PASSWORD=DOCUMENTED_DECOY_LOGIN
MYSQL_DECOY_PASSWORD=DOCUMENTED_DECOY_LOGIN
MYSQL_DECOY_ROOT_PASSWORD=DOCUMENTED_DECOY_LOGIN
# Base64 >=32 random bytes; preserve across reboot and retained-volume migration.
DECEPTIVE_PRINCIPAL_HMAC_SECRET=SUPPLY_STABLE_RANDOM_BASE64_KEY
# >=32 random characters. Preserve existing Redis evidence salt when migrating.
EVIDENCE_IP_HASH_SALT=SUPPLY_STABLE_RANDOM_PSEUDONYMIZATION_KEY
HONEYPOT_DATA_VOLUME_ID=SUPPLY_EXPLICIT_VOLUME_UUID
