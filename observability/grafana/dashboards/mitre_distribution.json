{
  "title": "MITRE ATT&CK Distribution",
  "uid": "capstone-mitre",
  "tags": ["capstone", "mitre"],
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Scale Up Events",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "capstone_scaling_scale_up_events", "legendFormat": "Scale-Ups"}],
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 3}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Total Signals Processed",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "capstone_scaling_total_signals"}]
    },
    {
      "id": 3, "type": "stat", "title": "Avg Actor Risk Score",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "capstone_mitre_avg_actor_risk", "legendFormat": "Avg Risk"}],
      "fieldConfig": {"defaults": {"decimals": 2, "color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 3}, {"color": "orange", "value": 6}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Tracked Actors",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "capstone_mitre_actor_count"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "MITRE Signals Rate",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(capstone_scaling_total_signals[2m])", "legendFormat": "signals/s"},
        {"expr": "rate(capstone_scaling_trap_triggers[2m])", "legendFormat": "trap triggers/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Global Score Statistics (EWMA)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "capstone_scaling_scorer_mean", "legendFormat": "global mean"},
        {"expr": "capstone_scaling_scorer_mean + capstone_scaling_scorer_std_dev", "legendFormat": "mean + 1σ"},
        {"expr": "capstone_scaling_scorer_mean - capstone_scaling_scorer_std_dev", "legendFormat": "mean - 1σ"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 7, "type": "gauge", "title": "Session Z-Scores (per session)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "capstone_session_z_score", "legendFormat": "{{session_id}}"}],
      "fieldConfig": {"defaults": {"min": -3, "max": 3, "color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": -3}, {"color": "yellow", "value": 1.5}, {"color": "red", "value": 2.5}]}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Scale-Up vs Scale-Down Events",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(capstone_scaling_scale_up_events[5m])", "legendFormat": "scale-up/5m"},
        {"expr": "rate(capstone_scaling_scale_down_events[5m])", "legendFormat": "scale-down/5m"},
        {"expr": "rate(capstone_scaling_noise_signals[5m])", "legendFormat": "noise suppressed/5m"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "schemaVersion": 36
}
