{
  "title": "Scaling Timeline",
  "uid": "capstone-scaling",
  "tags": [
    "capstone",
    "scaling",
    "keda"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Replicas",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_current_replicas"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scale-Up Events",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_scale_up_events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scale-Down Events",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_scale_down_events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Noise Suppressed",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_noise_signals"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "gray",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Global Mean Score",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_scorer_mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Global Std Dev",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_scorer_std_dev"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Samples",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_scorer_count"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Trap Triggers",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "capstone_scaling_trap_signals_total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replica Count Timeline",
      "description": "Intent-driven scaling \u2014 not CPU-based",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "capstone_scaling_current_replicas",
          "legendFormat": "replica target"
        },
        {
          "expr": "capstone_scaling_scorer_mean + 2*capstone_scaling_scorer_std_dev",
          "legendFormat": "Z-score threshold (mean+2\u03c3)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 12,
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "replica target"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Z-score threshold (mean+2\u03c3)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Aggregate Scaling Score and Target",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "capstone_scaling_scorer_mean",
          "legendFormat": "global score mean"
        },
        {
          "refId": "B",
          "expr": "capstone_scaling_current_replicas",
          "legendFormat": "desired replica target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "description": "Per-session series retired. Detailed session investigations use Evidence Store or Loki.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Signal Rate vs Noise Rate",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(capstone_scaling_total_signals[1m])",
          "legendFormat": "all signals/s"
        },
        {
          "expr": "rate(capstone_scaling_noise_signals[1m])",
          "legendFormat": "noise/s (bots)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "noise/s (bots)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Aggregate Scaling Score and Target",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "capstone_scaling_scorer_mean",
          "legendFormat": "global score mean"
        },
        {
          "refId": "B",
          "expr": "capstone_scaling_current_replicas",
          "legendFormat": "desired replica target"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Per-session series retired. Detailed session investigations use Evidence Store or Loki.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 36
}
